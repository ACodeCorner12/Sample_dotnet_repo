pipeline {
    agent any 
    
    //for triggered builds from ci pipeline
    //parameters {
        // Parameter to receive the build number from the CI job
        //string(name: 'CI_BUILD_NUMBER', defaultValue: '', description: 'Build number from the CI pipeline to deploy')
    //}

    environment {
        DEPLOY_DIR = '/var/www/mydotnetfolder' // The target directory for live deployment
        SOURCE_BUILD_DIR = "/opt/dotnet_builds/build_${params.artifact_id}"
    }

    stages {
        stage('Deploy Specific Build to www Directory') {
            steps {
                script {
                    echo "Checking for source build directory: ${SOURCE_BUILD_DIR}"
                    def build_exists = sh(script: "test -d ${SOURCE_BUILD_DIR}", returnStatus: true)
                    if(build_exists!=0){
                        echo "failed with exit code ${build_exists}"
                        echo "build specified does not exist, try a valid build version!"
                    }

                    echo "Deploying build number ${params.artifact_id} to ${DEPLOY_DIR}"
                    
                    // Ensure the deployment directory exists
                    sh "mkdir -p ${DEPLOY_DIR}"

                    echo "Cleaning the existing deployment directory"
                    sh "rm -rf ${DEPLOY_DIR}/*"

                    echo "Copying the specific build artifacts from the versioned directory"
                    sh "cp -r ${SOURCE_BUILD_DIR}/* ${DEPLOY_DIR}/"

                    echo "Deployment to ${DEPLOY_DIR} complete. You can now manually start/reload your service."
                }
            }
        }
    }
    post{
        success{
            emailext (
                subject: "SUCCESS: Jenkins Build #${env.BUILD_NUMBER} (${env.JOB_NAME})",
                body: """
                    <p>The build ${env.BUILD_NUMBER} was successful.</p>
                    <p>Project: ${env.JOB_NAME}</p>
                    <p>Check console output at: <a href='${env.BUILD_URL}'>${env.BUILD_URL}</a></p>
                """,
                to: 'anuragsaha.216009@gmail.com'
            )
            echo "CD pipeline running successfully."
        }
        
        failure{
        emailext (
                subject: "SUCCESS: Jenkins Build #${env.BUILD_NUMBER} (${env.JOB_NAME})",
                body: """
                    <p>The build ${env.BUILD_NUMBER} failed.</p>
                    <p>Project: ${env.JOB_NAME}</p>
                    <p>Check console output at: <a href='${env.BUILD_URL}'>${env.BUILD_URL}</a></p>
                """,
                to: 'anuragsaha.216009@gmail.com'
            )
        echo "CD pipeline failed."
        }
        aborted{
            emailext (
                    subject: "SUCCESS: Jenkins Build #${env.BUILD_NUMBER} (${env.JOB_NAME})",
                    body: """
                        <p>The build ${env.BUILD_NUMBER} was aborted.</p>
                        <p>Project: ${env.JOB_NAME}</p>
                        <p>Check console output at: <a href='${env.BUILD_URL}'>${env.BUILD_URL}</a></p>
                    """,
                    to: 'anuragsaha.216009@gmail.com'
                )
            echo "CD pipeline was aborted."
        }
    }
    
}
