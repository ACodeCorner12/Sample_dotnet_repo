// Jenkinsfile.CI
pipeline {
    agent any // Agent must have .NET SDK and write access to /opt/dotnet_builds/

    stages {
        stage('Build, Test, and Publish') {
            steps {
                checkout scm
                // Ensure the output directory is clean
                sh 'rm -rf dotnet_ci' 
                // Publish the build artifacts into the 'dotnet_ci' directory
                sh 'dotnet publish -c Release -o dotnet_ci'
                sh 'dotnet test --no-build'
            }
        }
    }
    
    post {
        success {
            script {
                def buildDir = "/opt/dotnet_builds/build_${env.BUILD_NUMBER}"
                echo "Storing build artifacts in: ${buildDir}"
                
                // Create the target directory
                sh "mkdir -p ${buildDir}"
                
                // Copy artifacts from Jenkins workspace to the versioned directory
                // We copy the contents of 'dotnet_ci'
                sh "cp -r dotnet_ci/* ${buildDir}/"
                
                //echo "Artifacts copied to external directory. Triggering CD job."

                // Trigger the CD job, passing the build number
                //build job: 'Your_CD_Job_Name', parameters: [string(name: 'CI_BUILD_NUMBER', value: "${env.BUILD_NUMBER}")]

                echo "CI pipeline running successfully"
            }

            emailext (
                subject: "✅ SUCCESS: Jenkins Build #${env.BUILD_NUMBER} (${env.JOB_NAME})",
                body: """
                    <p>The build ${env.BUILD_NUMBER} was successful.</p>
                    <p>Project: ${env.JOB_NAME}</p>
                    <p>Check console output at: <a href='${env.BUILD_URL}'>${env.BUILD_URL}</a></p>
                """,
                to: "anuragsaha.216009@gmail.com, anuragsaha1204@gmail.com"
            )
        }
        failure{
            echo "CI pipeline failed"
        }
    }
}
